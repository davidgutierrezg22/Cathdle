# Catchdle environment
ENVIRONMENT=development
OSU_CLIENT_ID=YOUR_CLIENT_ID
OSU_CLIENT_SECRET=YOUR_CLIENT_SECRET
OSU_REDIRECT_URI=http://localhost:8000/auth/callback
APP_ORIGIN=http://localhost:8000
# true in HTTPS/production; false only for local HTTP development
COOKIE_SECURE=false

# Production SQLite path (Render persistent disk)
CATCHDLE_DB_PATH=/var/data/catchdle.db
